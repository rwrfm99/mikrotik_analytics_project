APP_NAME="MikroTik Analytics"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8091
WEB_BIND=127.0.0.1
WEB_PORT=8091
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
# Puerto publicado en la PC; DB_PORT es el puerto interno del contenedor.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5433
DB_DATABASE=mikrotik_analytics
DB_USERNAME=mikrotik
DB_PASSWORD=change-me-local-only

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MIKROTIK_HOST=192.168.10.1
MIKROTIK_API_PORT=8728
MIKROTIK_API_TLS=false
MIKROTIK_TIMEOUT_SECONDS=5
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_LOCAL_NETWORK=192.168.8.0/22
MIKROTIK_COLLECTOR_ENABLED=false
HOTSPOT_POLL_SECONDS=15
HOTSPOT_MISSING_THRESHOLD=3

CLICKHOUSE_HOST=http://clickhouse:8123
CLICKHOUSE_PASSWORD=
CLICKHOUSE_READER_PASSWORD=
IPFIX_BIND=0.0.0.0
IPFIX_PORT=2055
IPFIX_EXPORTERS=192.168.10.1
